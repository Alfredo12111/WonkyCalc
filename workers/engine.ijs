NB. WonkyCalc's numerical engine. All numerical evaluation happens in J.
NB. The only loaded program is generated by the allowlisted Tcl planner.

wc_error =: 'The numerical engine could not evaluate this expression.'
wc_require =: 4 : 0
  if. -. *./ ,y do.
    wc_error =: x
    13!:8 (3)
  end.
  y
)
wc_finite =: 3 : 0
  if. 16 = 3!:0 y do.
    'This result is complex. WonkyCalc currently calculates real numbers.' wc_require 0 = 11 o. y
    y =. 9 o. y
  end.
  'The result exceeds the finite numeric range.' wc_require (|y) < _
  y
)
wc_angle =: 3 : 'y * (1 - wc_degrees) + wc_degrees * (o. 1) % 180'
wc_unangle =: 3 : 'y * (1 - wc_degrees) + wc_degrees * 180 % (o. 1)'
wc_add =: +/
wc_sub =: 3 : '({.y) - {:y'
wc_mul =: */
wc_div =: 3 : 0
  'Division by zero is undefined.' wc_require 0 ~: {:y
  ({.y) % {:y
)
wc_pow =: 3 : 0
  'Zero to a non-positive power is undefined.' wc_require -. (0 = {.y) *. 0 >: {:y
  ({.y) ^ {:y
)
wc_neg =: -
wc_percent =: 3 : 'y % 100'
wc_sin =: 3 : '1 o. wc_angle y'
wc_cos =: 3 : '2 o. wc_angle y'
wc_tan =: 3 : 0
  a =. wc_angle y
  'Tangent is undefined at this angle.' wc_require 1e_14 < | 2 o. a
  3 o. a
)
wc_asin =: 3 : 0
  'asin needs a value between -1 and 1.' wc_require 1 >: | y
  wc_unangle _1 o. y
)
wc_acos =: 3 : 0
  'acos needs a value between -1 and 1.' wc_require 1 >: | y
  wc_unangle _2 o. y
)
wc_atan =: 3 : 'wc_unangle _3 o. y'
wc_sinh =: 3 : '5 o. y'
wc_cosh =: 3 : '6 o. y'
wc_tanh =: 3 : '7 o. y'
wc_asinh =: 3 : '_5 o. y'
wc_acosh =: 3 : 0
  'acosh needs a value greater than or equal to 1.' wc_require y >: 1
  _6 o. y
)
wc_atanh =: 3 : 0
  'atanh needs a value strictly between -1 and 1.' wc_require 1 > | y
  _7 o. y
)
wc_ln =: 3 : 0
  'Logarithms need a positive argument.' wc_require y > 0
  ^. y
)
wc_log =: 3 : '(wc_ln y) % ^. 10'
wc_log2 =: 3 : '(wc_ln y) % ^. 2'
wc_logn =: 3 : 0
  b =. {: y
  'The logarithm base must be positive and different from 1.' wc_require (b > 0) *. b ~: 1
  (wc_ln {.y) % ^. b
)
wc_exp =: ^
wc_sqrt =: 3 : 0
  'Square root needs a non-negative argument in real-number mode.' wc_require y >: 0
  %: y
)
wc_cbrt =: 3 : '(* y) * (| y) ^ (1 % 3)'
wc_abs =: |
wc_floor =: <.
wc_ceil =: >.
wc_round =: 3 : '(* y) * <. 0.5 + | y'
wc_fact =: 3 : 0
  'Factorial needs an integer from 0 to 170.' wc_require (y = <.y) *. (y >: 0) *. y <: 170
  ! y
)
wc_recip =: 3 : 'wc_div 1,y'
wc_deg =: 3 : 'y * 180 % o. 1'
wc_rad =: 3 : 'y * (o. 1) % 180'
wc_root =: 3 : 0
  a =. {.y
  n =. {:y
  'The root degree cannot be zero.' wc_require n ~: 0
  if. a < 0 do.
    'A negative number needs an odd integer root degree.' wc_require (n = <.n) *. 1 = 2 | n
    - (|a) ^ %n
  else.
    'A negative-degree root of zero is undefined.' wc_require -. (a = 0) *. n < 0
    a ^ %n
  end.
)
wc_mod =: 3 : 0
  'Modulo by zero is undefined.' wc_require 0 ~: {:y
  ({:y) | {.y
)
wc_counts =: 3 : 0
  'Combinations and permutations need integers 0 <= r <= n <= 170.' wc_require (*./ y = <.y) *. (*./ y >: 0) *. (({.y) >: {:y) *. ({.y) <: 170
  y
)
wc_ncr =: 3 : 0
  wc_counts y
  ({:y) ! {.y
)
wc_npr =: 3 : 0
  wc_counts y
  a =. {.y
  r =. {:y
  */ a - i. r
)
wc_integer =: 3 : 0
  'gcd and lcm need integers with magnitude at most 2^53.' wc_require (*./ y = <.y) *. *./ (|y) <: 9007199254740992
  |y
)
wc_gcd =: 3 : '+./ wc_integer y'
wc_lcm =: 3 : '*./ wc_integer y'
wc_atan2 =: 3 : 0
  a =. {.y
  b =. {:y
  'atan2(0,0) is undefined.' wc_require (a ~: 0) +. b ~: 0
  wc_unangle 12 o. b j. a
)
wc_sum =: +/
wc_mean =: +/ % #
wc_median =: 3 : 0
  s =. /:~ ,y
  k =. (<:#s) % 2
  wc_mean ((<.k), >.k) { s
)
wc_min =: <./
wc_max =: >./
wc_variance =: 3 : 'wc_mean *: y - wc_mean ,y'
wc_stdev =: 3 : '%: wc_variance ,y'
wc_hypot =: 3 : 0
  m =. >./ | ,y
  if. m = 0 do. 0 else. m * %: +/ *: y % m end.
)

wc_run =: 3 : 0
  try.
    0!:0 <'plan.ijs'
    wc_answer =: wc_finite wc_answer
    9!:11 (17)
    text =. , ": wc_answer
    NB. J uses underscores for numeric minus signs; export standard notation.
    text =. '-' (I. text = '_') } text
    text (1!:2) <'result.txt'
  catch.
    wc_error (1!:2) <'error.txt'
    2!:55 (1)
  end.
  2!:55 (0)
)
wc_run ''
